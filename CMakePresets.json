{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_CLIENT": "ON",
        "BUILD_SERVER": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-with-tests",
      "displayName": "Release with Tests",
      "inherits": "release",
      "cacheVariables": {
        "BUILD_COMMON_TESTS": "ON",
        "BUILD_CLIENT_TESTS": "ON"
      }
    }
  ]
}